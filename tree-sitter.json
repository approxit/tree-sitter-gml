{
  "grammars": [
    {
      "name": "gml",
      "camelcase": "GML",
      "scope": "source.gml",
      "file-types": [
        ".gml"
      ],
      "injection-regex": "^gml$"
    }
  ],
  "metadata": {
    "version": "0.1.1",
    "license": "MIT",
    "description": "Game Modeling Language (GML) grammar for tree-sitter",
    "authors": [
      {
        "name": "Approxit"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-gml"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}