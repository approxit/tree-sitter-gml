{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "gml",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "model"
          },
          {
            "type": "SYMBOL",
            "name": "_line_blank"
          }
        ]
      }
    },
    "model": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_line_start"
        },
        {
          "type": "FIELD",
          "name": "base",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "text_immediate"
            },
            "named": true,
            "value": "text"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "text"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "body",
              "content": {
                "type": "SYMBOL",
                "name": "body"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "section": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "text"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "body",
              "content": {
                "type": "SYMBOL",
                "name": "body"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "body": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_indent"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "section"
            },
            {
              "type": "SYMBOL",
              "name": "struct_row"
            },
            {
              "type": "SYMBOL",
              "name": "table_row"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_continue"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "section"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "struct_row"
                  },
                  {
                    "type": "SYMBOL",
                    "name": "table_row"
                  }
                ]
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_dedent"
        }
      ]
    },
    "struct_row": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "SYMBOL",
            "name": "text"
          }
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "text"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "table_row": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT1",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "|"
              },
              {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "text_or_empty"
                },
                "named": true,
                "value": "text"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "|"
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    },
    "_comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    },
    "text": {
      "type": "PATTERN",
      "value": "[^:|#\\n]+"
    },
    "text_or_empty": {
      "type": "PATTERN",
      "value": "[^:|#\\n]*"
    },
    "text_immediate": {
      "type": "PATTERN",
      "value": "[^ \\t:|#\\n][^:|#\\n]*"
    },
    "_ws": {
      "type": "PATTERN",
      "value": "[ \\t]+"
    },
    "_line_blank": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_line_start"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_ws"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_line_end"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t\\r]"
    },
    {
      "type": "SYMBOL",
      "name": "_comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_line_start"
    },
    {
      "type": "SYMBOL",
      "name": "_line_end"
    },
    {
      "type": "SYMBOL",
      "name": "_indent"
    },
    {
      "type": "SYMBOL",
      "name": "_continue"
    },
    {
      "type": "SYMBOL",
      "name": "_dedent"
    },
    {
      "type": "SYMBOL",
      "name": "error"
    }
  ],
  "inline": [],
  "supertypes": []
}
